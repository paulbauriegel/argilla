# Test environment configuration
ARGILLA_AI_ASSIST_MODEL_ID=facebook/sam3
ARGILLA_AI_ASSIST_DEVICE=cpu

# Server settings
ARGILLA_AI_ASSIST_HOST=127.0.0.1
ARGILLA_AI_ASSIST_PORT=6951
ARGILLA_AI_ASSIST_CORS_ORIGINS=["*"]

# Auth settings
ARGILLA_AI_ASSIST_ALGORITHM=HS256
ARGILLA_AI_ASSIST_DATABASE_URL=sqlite+aiosqlite:///${HOME}/.argilla/argilla-test.db?check_same_thread=False
ARGILLA_AI_ASSIST_REDIS_URL=redis://localhost:6379/1 # Using a different Redis database for testing

# Model thresholds
ARGILLA_AI_ASSIST_THRESHOLD=0.5
ARGILLA_AI_ASSIST_MASK_THRESHOLD=0.5
